# ==============================================================================
# Default Behaviour
# ==============================================================================

# Normalise all unrecognised text files to LF in the repository.
# Git will convert to the platform line ending on checkout (CRLF on Windows,
# LF on macOS/Linux). This is the safest default for cross-platform teams.
*                   text=auto

# ==============================================================================
# Kotlin & Gradle Sources
# ==============================================================================

# Kotlin source and script files
*.kt                text diff=kotlin
*.kts               text diff=kotlin

# Gradle Kotlin DSL build files — explicit entry documents intent and survives
# future rule changes; *.kts above already catches these, but reviewers benefit
# from seeing the primary build file format called out unambiguously.
*.gradle.kts        text diff=kotlin

# Gradle build files (Groovy DSL — legacy; kept for mixed-DSL modules)
*.gradle            text diff=java

# Gradle wrapper scripts — must be LF on disk so POSIX shells can execute them
# directly on Linux/macOS CI runners without conversion.
gradlew             text eol=lf
gradlew.bat         text eol=crlf


# ==============================================================================
# JVM / Java Interop
# ==============================================================================

# Java sources present in some KMP modules (expect/actual Java implementations,
# annotation processors, or legacy interop layers)
*.java              text diff=java


# ==============================================================================
# Apple / iOS (Kotlin/Native interop)
# ==============================================================================

# Swift sources (Kotlin/Native Swift interop, iOS app entry points)
*.swift             text diff=swift

# Objective-C implementation and interface files (cinterop headers, legacy glue)
*.m                 text diff=objc
*.mm                text diff=objc

# C/C++ headers used by cinterop def files
*.h                 text diff=cpp
*.hpp               text diff=cpp
*.c                 text diff=cpp
*.cpp               text diff=cpp

# Kotlin/Native cinterop definition files
*.def               text

# Kotlin binary-compatibility-validator API dump files — text, tracked as part
# of the library's public ABI contract; diffs must be human-readable.
*.api               text


# ==============================================================================
# Web / JavaScript / WebAssembly (Kotlin/JS & Kotlin/Wasm targets)
# ==============================================================================

*.js                text diff=javascript
*.mjs               text diff=javascript
*.cjs               text diff=javascript
*.ts                text diff=javascript
*.tsx               text diff=javascript

*.css               text diff=css
*.scss              text diff=css
*.sass              text diff=css

*.html              text diff=html
*.htm               text diff=html


# ==============================================================================
# Configuration & Data Formats
# ==============================================================================

*.xml               text
*.json              text
*.yaml              text
*.yml               text
*.toml              text
*.properties        text
*.ini               text
*.cfg               text
*.conf              text


# ==============================================================================
# Database & Query Files
# ==============================================================================

# SQLDelight source files (.sq) and migration files (.sqm)
*.sq                text
*.sqm               text

# Plain SQL scripts
*.sql               text


# ==============================================================================
# Documentation & Markup
# ==============================================================================

*.md                text
*.mdx               text
*.txt               text
*.rst               text
*.adoc              text


# ==============================================================================
# Shell & Script Files
# ==============================================================================

# Shell scripts must use LF so they are executable on POSIX systems directly
# from a Windows checkout. Note: the execute permission bit itself must be set
# separately via `git update-index --chmod=+x` and is not controlled here.
*.sh                text eol=lf
*.bash              text eol=lf
*.cgi               text eol=lf

# Windows batch scripts require CRLF to run correctly on Windows, even when
# checked out from a Linux/macOS machine via a network share or WSL mount.
*.bat               text eol=crlf
*.cmd               text eol=crlf

# Python scripts (used in CI tooling and build utilities)
*.py                text diff=python


# ==============================================================================
# Binary — JVM Artefacts
# ==============================================================================

# "binary" is a Git macro for "-text -diff": disables line-ending conversion
# and textual diffing. All compiled and packaged JVM outputs belong here.
*.class             binary
*.jar               binary
*.aar               binary
*.war               binary
*.ear               binary


# ==============================================================================
# Binary — Kotlin/Native & Apple Framework Artefacts
# ==============================================================================

*.klib              binary
*.a                 binary
*.so                binary
*.dylib             binary
*.framework         binary
*.xcframework       binary
*.kexe              binary


# ==============================================================================
# Binary — Native Libraries & Shared Objects
# ==============================================================================

*.dll               binary
*.exe               binary
*.lib               binary


# ==============================================================================
# Binary — Signing & Certificates
# ==============================================================================

*.jks               binary
*.keystore          binary
*.p12               binary
*.cer               binary
*.der               binary


# ==============================================================================
# Binary — Databases
# ==============================================================================

*.db                binary
*.sqlite            binary
*.sqlite3           binary
*.realm             binary


# ==============================================================================
# Binary — Images & Media
# ==============================================================================

*.png               binary
*.jpg               binary
*.jpeg              binary
*.gif               binary
*.webp              binary
*.ico               binary
# SVG is XML-based text; force LF to keep diffs stable across design tools
# that occasionally emit CRLF (Figma export, Inkscape on Windows, etc.).
*.svg               text eol=lf
*.pdf               binary
*.ttf               binary
*.otf               binary
*.woff              binary
*.woff2             binary


# ==============================================================================
# Binary — Archives & Packages
# ==============================================================================

*.zip               binary
*.tar               binary
*.gz                binary
*.bz2               binary
*.7z                binary
*.rar               binary
*.xz                binary


# ==============================================================================
# GitHub Linguist Overrides
# ==============================================================================

# KSP and KAPT generated sources — excluded from language statistics because
# they are machine-produced and do not reflect authored code.
**/generated/**     linguist-generated=true

# Gradle wrapper JAR — binary dependency, not authored code
gradle/wrapper/gradle-wrapper.jar  linguist-vendored=true

# Lock files — dependency snapshots, not source code
**/package-lock.json    linguist-generated=true
**/yarn.lock            linguist-generated=true
